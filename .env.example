# Copy to .env. Do not commit credentials or private endpoints.
fastapi_embed=http://localhost:8010
fastapi_retrieve=http://localhost:8011
fastapi_rerank=http://localhost:8012
fastapi_ner=http://localhost:8008
fastapi_nli=http://localhost:8009

# Hugging Face model IDs or absolute paths to local checkpoints.
EMBEDDER_MODEL_PATH=BAAI/bge-small-en-v1.5
RERANKER_MODEL_PATH=BAAI/bge-reranker-v2-m3
NER_MODEL_PATH=dbmdz/bert-large-cased-finetuned-conll03-english
NLI_MODEL_PATH=MoritzLaurer/DeBERTa-v3-base-mnli

# Paths relative to the repository root, or absolute paths.
FLASHRAG_DATASET_DIR=flashrag-dataset
FLASHRAG_CORPUS_DIR=flashrag-dataset/retrieval-corpus
COVER_RAG_INDEX_DIR=tmp
# Dataset revision.
FLASHRAG_REVISION=64d4a872814da55c8284f5536795df03c39ddad2
# Optional: set HF_HOME to an absolute Hugging Face cache directory.
# Optional MetaRAG expert checkpoint (required only for that baseline).
# METARAG_EXPERT_MODEL_PATH=/path/to/T5-LM-Large_Canard-HotpotQA-rephrase
